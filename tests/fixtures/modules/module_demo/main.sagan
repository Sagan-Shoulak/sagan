module main

import course from guidance as calculate_course
import Inventory from telemetry
import telemetry as flight_data

fun main(): Int {
  let answer = calculate_course(40)
  let direct_offset = flight_data.offset()
  let signal = flight_data.Signal.nominal
  let inventory = Inventory({flight_data.Signal.nominal: 2.0 kilogram})
  print("Cross-module answer: ${answer}")
  print("Namespace offset: ${direct_offset}")
  print("Namespace enum: ${signal}")
  print("Exported enum signature: ${inventory.nominal()}")
  if answer == 42 and direct_offset == 2 and signal == flight_data.Signal.nominal and inventory.nominal() == 2.0 kilogram return 0
  else return 1
}

exit(main())
